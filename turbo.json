{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "BACKEND_URL",
        "NEXTAUTH_SECRET",
        "FRONTEND_URL",
        "NEXT_PUBLIC_PORTAL_URL",
        "NEXT_PUBLIC_PULL_TEST_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_CYCLOPS_URL",
        "NEXT_PUBLIC_HYDRA_URL",
        "NEXT_PUBLIC_PROFESSOR_URL",
        "NEXT_PUBLIC_OPTIC_BOLT_URL",
        "NEXT_PUBLIC_OPTIC_BOLT_URL_DEV"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {},
    "type-check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
