// This is the Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  seed     = "ts-node prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SANDVIK_ADMIN
  SANDVIK_TECHNICIAN
}

enum Role {
  COMPANY_USER
  COMPANY_ADMIN
  SANDVIK_ADMIN
  SANDVIK_TECHNICIAN
}

enum Result {
  PASS
  FAIL
  ABORT
}

enum PullTestAbortReason {
  NOT_TESTED_VOID_CAVITY
  TEST_STOPPED_INSTALL_ANGLE
  PEG_NOT_EXTRUDED
  HIGH_ANGLE_NOT_PERPENDICULAR
  REBAR_EJECTED_STOPPER_CAUGHT
  BOLT_END_DAMAGE_RIG_NOT_ENGAGING
  NOT_TESTED_BROKEN_BOLT_NUT
  NOT_TESTED_PULL_TEST_COLLAR_INSTALLED_BACKWARDS
}

enum Application {
  PULL_TEST
  PULL_TEST_TECHNICIAN
  BANSHEE
}

enum PlanLevel {
  GOLD
  SILVER
  BRONZE
  INACTIVE
}

enum BoltType {
  D47_MD_1_8_M
  D47_MD_2_1_M
  D47_MD_2_4_M
  D47_MD_3_0_M
  D47_MD_3_8_M
  D47_MDX_1_8_M
  D47_MDX_2_1_M
  D47_MDX_2_4_M
  D47_MDX_3_0_M
  D47_MDX_3_8_M
  D47_MDX_4_0_M
  D39_MDX_1_8_M
  D39_MDX_2_1_M
  D39_MDX_2_4_M
  D39_MDX_3_0_M
  D47_MDX_PEG_BOLT_1_8_M
  D47_MDX_PEG_BOLT_2_1_M
  D47_MDX_PEG_BOLT_2_4_M
  D47_MDX_PEG_BOLT_3_0_M
  D39_MDX_PEG_BOLT_1_8_M
  D39_MDX_PEG_BOLT_2_1_M
  D39_MDX_PEG_BOLT_2_4_M
  D39_MDX_PEG_BOLT_3_0_M
  D47_MD_PEG_BOLT_1_8_M
  D47_MD_PEG_BOLT_2_1_M
  D47_MD_PEG_BOLT_2_4_M
  D47_MD_PEG_BOLT_3_0_M
  FRICTION_BOLT_47_MM
  FRICTION_BOLT_39_MM
  FRICTION_BOLT_33_MM
  SPIRAL_FRICTION_BOLT
  KINLOC_BOLT
  KINLOC_BOLT_INDIE
}

enum RingPosition {
  RH_BACKS
  RH_SHOULDER
  RH_WALL_UPPER
  RH_WALL_CENTER
  RH_WALL_LOWER
  RH_FACE_HIGH
  RH_FACE_LOW
  LH_BACKS
  LH_SHOULDER
  LH_WALL_UPPER
  LH_WALL_CENTER
  LH_WALL_LOWER
  LH_FACE_HIGH
  LH_FACE_LOW
  CENTER_BACKS
}

model RefreshTokenId {
  userId    String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokenId String @unique

  @@map("refresh_token_ids")
}

model Company {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                String
  orgNumber           String @unique
  address             String
  postalCode          String
  city                String
  country             String
  companyContactEmail String

  plan                Plan[]
  site                Site[]
  userPermission      UserPermission[]
  invitation          Invitation[]
  bansheeSessionStats BansheeSessionStats[]
  bansheeRequests     BansheeRequest[]
  templates           BansheeTemplate[]
  cartItems           BansheeCartItem[]
  orders              BansheeOrder[]

  @@map("companies")
}

model Plan {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationName Application
  planLevel       PlanLevel
  expiringDate    DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@map("plans")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String @unique
  hash  String

  fullName           String
  workPlace          String
  phoneNumber        String?
  globalRole         GlobalRole? // For role SANDVIK_TECHNICIAN or SANDVIK_ADMIN
  isGlobalVisibility Boolean? // For role SANDVIK_TECHNICIAN
  isDeleted          Boolean     @default(false) // Soft delete flag

  userRole             UserPermission[]
  boltResult           BoltResult[]
  passwordResetRequest PasswordResetRequest[]

  @@map("users")
}

model PasswordResetRequest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UserPermission {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role // SANDVIK_TECHNICIAN, SANDVIK_ADMIN, COMPANY_ADMIN or COMPANY_USER

  appsAccess Application[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@map("user_permissions")
}

model Invitation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  companyId  String?
  company    Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role       Role?
  globalRole GlobalRole?

  appsAccess         Application[]
  isGlobalVisibility Boolean?

  @@map("invitations")
}

model Site {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteName   String @unique
  address    String
  postalCode String
  city       String
  country    String

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  level               Level[]
  boltResult          BoltResult[]
  bansheeRequests     BansheeRequest[]
  bansheeSessionStats BansheeSessionStats[]
  templates           BansheeTemplate[]
  cartItems           BansheeCartItem[]
  orderItems          BansheeOrderItem[]

  @@map("sites")
}

model Level {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levelName String

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId String

  drive           Drive[]
  boltResult      BoltResult[]
  bansheeRequests BansheeRequest[]
  templates       BansheeTemplate[]
  cartItems       BansheeCartItem[]
  orderItems      BansheeOrderItem[]

  @@map("levels")
}

model Drive {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driveName String

  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  levelId String

  location        Location[]
  boltResult      BoltResult[]
  bansheeRequests BansheeRequest[]
  templates       BansheeTemplate[]
  cartItems       BansheeCartItem[]
  orderItems      BansheeOrderItem[]

  @@map("drives")
}

model Location {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationName String

  drive   Drive  @relation(fields: [driveId], references: [id], onDelete: Cascade)
  driveId String

  boltResult      BoltResult[]
  bansheeRequests BansheeRequest[]
  templates       BansheeTemplate[]
  cartItems       BansheeCartItem[]
  orderItems      BansheeOrderItem[]

  @@map("locations")
}

model BoltResult {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boltNumber       Int
  boltType         BoltType
  peakLoad         Int[]
  peakDisplacement Int[]
  positionInRing   RingPosition

  result              Result
  isHazard            Boolean              @default(false)
  hazardCompletedDate DateTime[] // Need to make optional
  abortReason         PullTestAbortReason?
  comment             String?
  image               String? // base64

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId String

  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  levelId String

  drive   Drive  @relation(fields: [driveId], references: [id], onDelete: Cascade)
  driveId String

  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("bolt_results")
}

////////////////////////////////////////

model Coffee {
  id        Int            @id @default(autoincrement())
  name      String
  brand     String
  flavors   CoffeeFlavor[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("coffees")
}

model Flavor {
  id        Int            @id @default(autoincrement())
  name      String
  coffees   CoffeeFlavor[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("flavors")
}

model CoffeeFlavor {
  coffeeId Int
  flavorId Int

  coffee Coffee @relation(fields: [coffeeId], references: [id])
  flavor Flavor @relation(fields: [flavorId], references: [id])

  @@id([coffeeId, flavorId])
  @@map("coffee_flavors")
}

model BansheeBoltTypeConstant {
  id                   String   @id @default(uuid())
  boltType             BoltType
  velocity             Float
  tempCorrectionFactor Float
  tempCoeff            Float
  quadCoeff1           Float
  linCoeff1            Float
  quadCoeff2           Float
  linCoeff2            Float
  constTerm            Float
  nominalLength        Float
  linearLimit          Float
  elasticLimit         Float
  lowPlasticLimit      Float
  createdAt            DateTime
  updatedAt            DateTime @updatedAt

  @@map("banshee_bolt_type_constants")
}

model BansheeRequest {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serialNumber             String            @unique
  name                     String?
  levelId                  String
  driveId                  String
  locationId               String
  coordinates              Json?
  period                   Int
  boltType                 BoltType
  locationDetails          String?
  boltInstallationDateTime DateTime?
  ringPosition             RingPosition
  comment                  String?
  isBrokenBolt             Boolean
  isNotMeasurable          Boolean
  images                   String[]
  measured                 Boolean           @default(false)
  proceqData               ProceqData[]
  eventLogs                BansheeEventLog[]
  isProceqSynced           Boolean           @default(false)
  activateNotifications    Boolean           @default(false)

  createdBy String
  updatedBy String?

  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  drive     Drive    @relation(fields: [driveId], references: [id], onDelete: Cascade)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  cartItems  BansheeCartItem[]
  orderItems BansheeOrderItem[]

  @@index([createdBy])
  @@index([serialNumber])
  @@index([companyId])
  @@index([siteId])
  @@map("banshee_requests")
}

model BansheeEventLog {
  id        String    @id @default(uuid())
  createdAt DateTime?

  eventType      String
  previousStatus ProceqStatus
  newStatus      ProceqStatus
  measurementId  String?

  bansheeRequest   BansheeRequest @relation(fields: [bansheeRequestId], references: [id], onDelete: Cascade)
  bansheeRequestId String

  @@index([bansheeRequestId])
  @@index([createdAt])
  @@map("banshee_event_logs")
}

enum ProceqStatus {
  ELASTIC
  LOW_PLASTIC
  HIGH_PLASTIC
  BROKEN
  NOT_MEASURABLE
  UNMEASURED
}

model ProceqData {
  id               String        @id @default(uuid())
  fileName         String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  measurementId    String        @unique
  operatorEmail    String?
  comments         String?
  temperature      Float?
  userPhoto        Json?
  rawDataZipId     String?
  rawDataZipPath   String?
  createdTimestamp DateTime?
  updatedTimestamp DateTime?
  dueDate          DateTime?
  status           ProceqStatus?

  bansheeRequestId  String?
  bansheeRequest    BansheeRequest?    @relation(fields: [bansheeRequestId], references: [id], onDelete: Cascade)
  proceqAttachments ProceqAttachment[]
  readings          ProceqReading[]

  @@map("proceq_data")
}

model ProceqReading {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readingIndex                     Int           @default(0)
  indicationSetupFileName          String?
  measuringMode                    String?
  frequency                        Float?
  gain                             Float?
  voltage                          Int?
  sampleAveraging                  Int?
  damping                          Int?
  analogueFilter                   Int?
  zeroOffset                       Float?
  velocity                         Float?
  level                            Float?
  measurementLevel                 Float?
  referenceSamplingRate            Int?
  start                            Float?
  width                            Float?
  gate1MaximumAmplitude            Float?
  gate1SoundPathDistance           Float?
  gate1SoundPathDistanceInTimeUnit Float?
  status                           ProceqStatus?
  elongation                       Float?
  proceqData                       ProceqData    @relation(fields: [proceqDataId], references: [id], onDelete: Cascade)
  proceqDataId                     String

  @@unique([proceqDataId, readingIndex])
  @@map("proceq_readings")
}

model ProceqToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operatorEmail String   @unique
  accessToken   String
  refreshToken  String
  expiresAt     DateTime

  @@map("proceq_tokens")
}

model ProceqAttachment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachmentId   String  @unique
  fileName       String
  filePath       String
  fileType       String
  fileSize       Int
  attachmentType String
  description    String?

  proceqData   ProceqData @relation(fields: [proceqDataId], references: [id])
  proceqDataId String

  @@map("proceq_attachments")
}

model BansheeSessionStats {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionDate DateTime

  totalMeasured Int @default(0)
  notMeasurable Int @default(0)
  broken        Int @default(0)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([companyId, siteId, sessionDate])
  @@map("banshee_session_stats")
}

model BansheeTemplate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy String
  updatedBy String

  templateName             String
  period                   Int       @default(0)
  boltInstallationDateTime DateTime?

  siteId          String?
  site            Site?     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  levelId         String?
  level           Level?    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  driveId         String?
  drive           Drive?    @relation(fields: [driveId], references: [id], onDelete: Cascade)
  locationId      String?
  locationDetails String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  coordinates Json?

  activateNotifications Boolean @default(false)
  comment               String?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  ringPosition RingPosition? //need to check

  @@index([companyId])
  @@map("templates")
}

// ===== Banshee Cart / Order Flow =====

enum BansheeCartItemType {
  NEW_BANSHEE
  SERVICE_EXISTING
}

enum BansheeOrderStatus {
  PENDING
  COMPLETED
  PARTIALLY_COMPLETED
  CANCELLED
}

enum BansheeOrderItemStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model BansheeCartItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemType BansheeCartItemType

  // --- SERVICE_EXISTING ---
  bansheeRequestId String?

  // --- NEW_BANSHEE ---
  name     String?
  quantity Int     @default(1)
  period   Int?

  siteId     String?
  levelId    String?
  driveId    String?
  locationId String?

  site     Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  level    Level?    @relation(fields: [levelId], references: [id], onDelete: SetNull)
  drive    Drive?    @relation(fields: [driveId], references: [id], onDelete: SetNull)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  bansheeRequest BansheeRequest? @relation(fields: [bansheeRequestId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("cart_items")
}

model BansheeOrder {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status      BansheeOrderStatus @default(PENDING)
  attachments String[]
  comment     String

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  orderItems BansheeOrderItem[]

  @@index([companyId])
  @@index([status])
  @@map("orders")
}

model BansheeOrderItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemType BansheeCartItemType
  status   BansheeOrderItemStatus @default(PENDING)

  bansheeRequestId String?

  // NEW_BANSHEE snapshot (copied from CartItem at submission time)
  name   String?
  period Int?

  siteId     String?
  levelId    String?
  driveId    String?
  locationId String?

  site     Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  level    Level?    @relation(fields: [levelId], references: [id], onDelete: SetNull)
  drive    Drive?    @relation(fields: [driveId], references: [id], onDelete: SetNull)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  order   BansheeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  bansheeRequest BansheeRequest? @relation(fields: [bansheeRequestId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@map("order_items")
}
