<html lang='en' style='margin:0; padding:0;'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>Account Setup Invitation</title>
    <style>
      body, html { margin: 0; padding: 0; background-color: #f7f9fc;
      font-family: Arial, sans-serif; color: #333; -webkit-text-size-adjust:
      100%; -ms-text-size-adjust: 100%; } .container { max-width: 600px;
      background: #ffffff; margin: 20px auto; border-radius: 8px; box-shadow: 0
      0 10px rgba(0,0,0,0.05); padding: 24px 32px; } h1 { color: #1a73e8;
      font-size: 22px; margin-bottom: 16px; text-align: center; } p { font-size:
      16px; line-height: 1.5; margin: 12px 0; } .btn-container { text-align:
      center; } .btn { display: inline-block; padding: 12px 24px; margin: 16px
      0; font-size: 16px; color: #ffffff; background-color: #1a73e8;
      text-decoration: none; border-radius: 6px; font-weight: bold; text-align:
      center; transition: background-color 0.3s ease; } .btn:hover {
      background-color: #155ab6; } .footer { font-size: 14px; color: #888;
      text-align: center; margin-top: 32px; line-height: 1.6; } .footer-logo {
      text-align: center; margin-top: 20px; } .footer-logo img { max-width:
      120px; height: auto; } @media only screen and (max-width: 640px) {
      .container { margin: 12px; padding: 20px; } h1 { font-size: 20px; } p {
      font-size: 15px; } .btn { display: block; width: 80%; margin: 16px auto; }
      .footer-logo img { max-width: 100px; } }
    </style>
  </head>

  <body>
    <div class='container'>
      <h1>Set Up Your Ground Support Account</h1>

      <p>Hello <strong>{{username}}</strong>,</p>

      <p>You've been invited to join the Ground Support Platform </p>

      <p>Click the button below to set up your account and get started:</p>

      <div class='btn-container'>
        <a
          href='{{baseUrl}}/?email={{email}}'
          class='btn'
          target='_blank'
          rel='noopener'
        >
          Set Up Your Account
        </a>
      </div>

      <p>If you were not expecting this invitation, please ignore this email or
        contact our support team.</p>

      <div class='footer'>
        Thank you,<br />
        The Ground Support Team

        <div class='footer-logo'>
          <img src='cid:sandviklogo' alt='Sandvik Logo' />
        </div>
      </div>
    </div>
  </body>
</html>