generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String @unique
  hash  String

  firstName String?
  lastName  String?

  Bolts Bolt[]

  @@map("users")
}

model Bolt {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  pass        Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@map("bolts")
}

model RefreshTokenId {
  userId    String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokenId String @unique

  @@map("refresh_token_ids")
}
