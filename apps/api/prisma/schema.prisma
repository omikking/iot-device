// This is the Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SANDVIK_ADMIN
  SANDVIK_TECHNICIAN
  COMPANY_ADMIN
  USER
}

enum Result {
  PASS
  FAIL
  ABORT
}

enum PullTestAbortReason {
  NOT_TESTED_VOID_CAVITY
  TEST_STOPPED_INSTALL_ANGLE
}

enum Application {
  PULL_TEST
  PULL_TEST_OPERATOR
  XCYCLOPS
  ULTRABOLTS
}

enum PlanLevel {
  GOLD
  SILVER
  BRONZE
  INACTIVE
}

enum RingPosition {
  RH_BACKS
  RH_SHOULDER
  RH_WALL_UPPER
  LH_BACKS
  LH_SHOULDER
  LH_WALL_UPPER
  CENTER_BACKS
}

model Company {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                String
  orgNumber           String @unique
  address             String
  postalCode          String
  city                String
  country             String
  companyContactEmail String

  plan           Plan[]
  site           Site[]
  userPermission UserPermission[]

  @@map("companies")
}

model RefreshTokenId {
  userId    String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokenId String @unique

  @@map("refresh_token_ids")
}

// The data the request has when a company adds a user and give permissions:
// companyId
// userId
// role
// applicationsAccess: ['XCYCLOPS', 'PULL_TEST']

// how do we give permission to a user for the applications?

model Plan {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationName Application
  planLevel       PlanLevel
  expiringDate    DateTime?

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  user User[]

  @@map("plans")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String @unique
  hash  String

  // role             Role // @TODO This needs to be set per company (COMPANY_ADMIN would be shared across all companies)
  fullname         String
  workPlace        String
  phoneNumber      String?
  globalVisibility Boolean? // Only relevant for role SANDVIK_TECHNICIAN

  plan       Plan[] // @TODO Check if possible to set relations to be unique. Is this needed?? Remove?
  boltResult BoltResult[] // @TODO Check if this can be removed
  userRole   UserPermission[]

  @@map("users")
}

// TODO this needs a lot more work, not sure if this is correct
model UserPermission {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role
  user User @relation(fields: [userId], references: [id])

  userId    String
  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  // applicationAccess Application[] // this array could contain all the application that they get access to?

  @@map("user_permissions")
}

model Site {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteName   String
  address    String
  postalCode String
  city       String
  country    String

  // passCriteria String TODO should we remove for now?
  // notification String TODO should we remove for now?

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  level      Level[]
  boltResult BoltResult[] // @TODO Check if this can be removed

  @@map("sites")
}

model Level {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levelName String

  site   Site   @relation(fields: [siteId], references: [id])
  siteId String

  drive      Drive[]
  boltResult BoltResult[] // @TODO Check if this can be removed

  @@map("levels")
}

model Drive {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driveName String

  level   Level  @relation(fields: [levelId], references: [id])
  levelId String

  location   Location[]
  boltResult BoltResult[] // @TODO Check if this can be removed

  @@map("drives")
}

model Location {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationName String

  drive   Drive  @relation(fields: [driveId], references: [id])
  driveId String

  boltResult     BoltResult[] // @TODO Check if this can be removed
  PositionInRing PositionInRing[]

  @@map("locations")
}

model PositionInRing {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positionInRingName RingPosition

  location   Location @relation(fields: [locationId], references: [id])
  locationId String

  boltResult BoltResult[] // @TODO Check if this can be removed

  @@map("positions")
}

model BoltResult {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boltNumber       Int
  boltType         String // @TODO enum
  peakLoad         Int[]
  peakDisplacement Int[]
  // positionInRing   String // @TODO remove - done

  result              Result
  isHazard            Boolean              @default(false)
  hazardCompletedDate DateTime[]
  abortReason         PullTestAbortReason?
  comment             String?
  image               String? // This assumes base64

  site   Site   @relation(fields: [siteId], references: [id])
  siteId String

  level   Level  @relation(fields: [levelId], references: [id])
  levelId String

  drive   Drive  @relation(fields: [driveId], references: [id])
  driveId String

  // TODO: Add location! - done

  location   Location @relation(fields: [locationId], references: [id]) // @TODO Rename ring position - done
  locationId String

  positionInRing   PositionInRing @relation(fields: [positionInRingId], references: [id])
  positionInRingId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("bolt_results")
}

////////////////////////////////////////

model Coffee {
  id        Int            @id @default(autoincrement())
  name      String
  brand     String
  flavors   CoffeeFlavor[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("coffees")
}

model Flavor {
  id        Int            @id @default(autoincrement())
  name      String
  coffees   CoffeeFlavor[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("flavors")
}

model CoffeeFlavor {
  coffeeId Int
  flavorId Int

  coffee Coffee @relation(fields: [coffeeId], references: [id])
  flavor Flavor @relation(fields: [flavorId], references: [id])

  @@id([coffeeId, flavorId])
  @@map("coffee_flavors")
}
