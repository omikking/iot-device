{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "pipeline": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXTAUTH_SECRET",
        "BACKEND_URL",
        "FRONTEND_URL",
        "NEXT_PUBLIC_PORTAL_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_API_IMAGE_URL",
        "NEXT_PUBLIC_PULL_TEST_URL",
        "NEXT_PUBLIC_BANSHEE_URL",
        "NEXT_PUBLIC_TEST_CYCLOPS_URL",
        "NEXT_PUBLIC_TEST_HYDRA_URL",
        "NEXT_PUBLIC_TEST_PROFESSOR_URL",
        "NEXT_PUBLIC_TEST_OPTIC_BOLT_URL",
        "NEXT_PUBLIC_TEST_OPTIC_BOLT_URL_DEV",
        "COOKIE_DOMAIN",
        "NODE_ENV",
        "NEXT_PUBLIC_BANSHEE_URL"
      ]
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "lint": {},
    "type-check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}