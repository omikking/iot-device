// This is the Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  seed     = "ts-node prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SANDVIK_ADMIN
  SANDVIK_TECHNICIAN
}

enum Role {
  COMPANY_USER
  COMPANY_ADMIN
  SANDVIK_ADMIN
  SANDVIK_TECHNICIAN
}

enum Result {
  PASS
  FAIL
  ABORT
}

enum PullTestAbortReason {
  NOT_TESTED_VOID_CAVITY
  TEST_STOPPED_INSTALL_ANGLE
  PEG_NOT_EXTRUDED
  HIGH_ANGLE_NOT_PERPENDICULAR
  REBAR_EJECTED_STOPPER_CAUGHT
  BOLT_END_DAMAGE_RIG_NOT_ENGAGING
  PULL_TEST_COLLAR_INSTALLED_BACKWARDS
  BROKEN_BOLT_NUT
}

enum Application {
  PULL_TEST
  PULL_TEST_TECHNICIAN
  // BANSHEE
}

enum PlanLevel {
  GOLD
  SILVER
  BRONZE
  INACTIVE
}

enum BoltType {
  D47_MD_1_8_M
  D47_MD_2_1_M
  D47_MD_2_4_M
  D47_MD_3_0_M
  D47_MD_3_8_M
  D47_MDX_1_8_M
  D47_MDX_2_1_M
  D47_MDX_2_4_M
  D47_MDX_3_0_M
  D47_MDX_3_8_M
  D47_MDX_4_0_M
  D39_MDX_1_8_M
  D39_MDX_2_1_M
  D39_MDX_2_4_M
  D39_MDX_3_0_M
  D47_MDX_PEG_BOLT_1_8_M
  D47_MDX_PEG_BOLT_2_1_M
  D47_MDX_PEG_BOLT_2_4_M
  D47_MDX_PEG_BOLT_3_0_M
  D39_MDX_PEG_BOLT_1_8_M
  D39_MDX_PEG_BOLT_2_1_M
  D39_MDX_PEG_BOLT_2_4_M
  D39_MDX_PEG_BOLT_3_0_M
  D47_MD_PEG_BOLT_1_8_M
  D47_MD_PEG_BOLT_2_1_M
  D47_MD_PEG_BOLT_2_4_M
  D47_MD_PEG_BOLT_3_0_M
  FRICTION_BOLT_47_MM
  FRICTION_BOLT_47_MM_1_8_M
  FRICTION_BOLT_47_MM_2_1_M
  FRICTION_BOLT_47_MM_2_4_M
  FRICTION_BOLT_47_MM_3_0_M
  FRICTION_BOLT_39_MM
  FRICTION_BOLT_33_MM
  SPIRAL_FRICTION_BOLT
  KINLOC_BOLT
  KINLOC_BOLT_INDIE
}

enum RingPosition {
  RH_BACKS
  RH_SHOULDER
  RH_WALL_UPPER
  RH_WALL_CENTER
  RH_WALL_LOWER
  RH_FACE_HIGH
  RH_FACE_LOW
  LH_BACKS
  LH_SHOULDER
  LH_WALL_UPPER
  LH_WALL_CENTER
  LH_WALL_LOWER
  LH_FACE_HIGH
  LH_FACE_LOW
  CENTER_BACKS
}

model RefreshTokenId {
  userId    String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokenId String @unique

  @@map("refresh_token_ids")
}

model Company {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                String
  orgNumber           String @unique
  address             String
  postalCode          String
  city                String
  country             String
  companyContactEmail String

  plan           Plan[]
  site           Site[]
  userPermission UserPermission[]
  invitation     Invitation[]

  @@map("companies")
}

model Plan {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationName Application
  planLevel       PlanLevel
  expiringDate    DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@map("plans")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String @unique
  hash  String

  fullName           String
  workPlace          String
  phoneNumber        String?
  globalRole         GlobalRole? // For role SANDVIK_TECHNICIAN or SANDVIK_ADMIN
  isGlobalVisibility Boolean? // For role SANDVIK_TECHNICIAN
  isDeleted          Boolean     @default(false) // Soft delete flag

  userRole             UserPermission[]
  boltResult           BoltResult[]
  passwordResetRequest PasswordResetRequest[]

  @@map("users")
}

model PasswordResetRequest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UserPermission {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role // SANDVIK_TECHNICIAN, SANDVIK_ADMIN, COMPANY_ADMIN or COMPANY_USER

  appsAccess Application[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@map("user_permissions")
}

model Invitation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  companyId  String?
  company    Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role       Role?
  globalRole GlobalRole?

  appsAccess         Application[]
  isGlobalVisibility Boolean?

  @@map("invitations")
}

model Site {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteName   String @unique
  address    String
  postalCode String
  city       String
  country    String

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  level      Level[]
  boltResult BoltResult[]

  @@map("sites")
}

model Level {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levelName String

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId String

  drive      Drive[]
  boltResult BoltResult[]

  @@map("levels")
}

model Drive {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driveName String

  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  levelId String

  location   Location[]
  boltResult BoltResult[]

  @@map("drives")
}

model Location {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationName String

  drive   Drive  @relation(fields: [driveId], references: [id], onDelete: Cascade)
  driveId String

  boltResult BoltResult[]

  @@map("locations")
}

model BoltResult {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  measuredAt DateTime

  boltNumber       Int
  boltType         BoltType
  peakLoad         Int[]
  peakDisplacement Int[]
  positionInRing   RingPosition

  result              Result
  isHazard            Boolean              @default(false)
  hazardCompletedDate DateTime[] // Need to make optional
  abortReason         PullTestAbortReason?
  comment             String?
  image               String? // base64

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId String

  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  levelId String

  drive   Drive  @relation(fields: [driveId], references: [id], onDelete: Cascade)
  driveId String

  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("bolt_results")
}

////////////////////////////////////////

model Coffee {
  id        Int            @id @default(autoincrement())
  name      String
  brand     String
  flavors   CoffeeFlavor[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("coffees")
}

model Flavor {
  id        Int            @id @default(autoincrement())
  name      String
  coffees   CoffeeFlavor[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("flavors")
}

model CoffeeFlavor {
  coffeeId Int
  flavorId Int

  coffee Coffee @relation(fields: [coffeeId], references: [id])
  flavor Flavor @relation(fields: [flavorId], references: [id])

  @@id([coffeeId, flavorId])
  @@map("coffee_flavors")
}


model OpticboltTestResult {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serialNumber      String   @map("serial_number") @db.VarChar(50)
  drawingNumber     String?  @map("drawing_number") @db.VarChar(100)
  boltType          String?  @map("bolt_type") @db.VarChar(50)
  description       String?  @db.VarChar(255)
  testedAt          DateTime @map("tested_at") @db.Timestamptz
  testedBy          String   @map("tested_by") @db.VarChar(100)
  result            String   @db.VarChar(10)
  fibreCheck1       Boolean  @default(false) @map("fibre_check_1")
  fibreCheck2       Boolean  @default(false) @map("fibre_check_2")
  psi20             Int?     @map("psi_20")
  psi100            Int?     @map("psi_100")
  spectrumIndex     Int      @map("spectrum_index")
  amplitude20       Decimal? @map("amplitude_20") @db.Decimal(10, 4)
  wavelength20      Decimal? @map("wavelength_20") @db.Decimal(10, 4)
  amplitude100      Decimal? @map("amplitude_100") @db.Decimal(10, 4)
  wavelength100     Decimal? @map("wavelength_100") @db.Decimal(10, 4)
  peakInitialNm     Decimal? @map("peak_initial_nm") @db.Decimal(10, 4)
  peak20Nm          Decimal? @map("peak_20_nm") @db.Decimal(10, 4)
  peak100Nm         Decimal? @map("peak_100_nm") @db.Decimal(10, 4)
  strain20          Decimal? @map("strain_20") @db.Decimal(10, 6)
  strain100         Decimal? @map("strain_100") @db.Decimal(10, 6)
  load20            Decimal? @map("load_20") @db.Decimal(10, 4)
  load100           Decimal? @map("load_100") @db.Decimal(10, 4)
  time20Ms          Int?     @map("time_20_ms")
  time100Ms         Int?     @map("time_100_ms")
  calibrationFactor Decimal? @map("calibration_factor") @db.Decimal(10, 6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([serialNumber, testedAt, spectrumIndex])
  @@map("opticbolt_test_results")
}

 