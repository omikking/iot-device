{
  "name": "ground-support-platform",
  "author": "Felix Östergren <felix.ostergren@sandvik.com>",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "turbo run start --filter=web --filter=pull-test --filter=banshee",
    "lint": "turbo lint",
    "db:seed": "pnpm --filter api db:seed",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@gsp/typescript-config": "workspace:*",
    "@types/graphql-upload": "^17.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "turbo": "^1.13.4"
  },
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "graphql-upload-ts": "^2.1.3"
  }
}