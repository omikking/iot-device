// This is the Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SANDVIK_ADMIN
  SANDVIK_TECHNICIAN
  COMPANY_ADMIN
  USER
}

enum Result {
  PASS
  FAIL
  ABORT
}

// @TODO Check if there are any more types of abort reasons
// @TODO Add app specific naming for apps
enum AbortReason {
  NOT_TESTED_VOID_CAVITY
  TEST_STOPPED_INSTALL_ANGLE
}

enum Application {
  PULL_TEST
  PULL_TEST_OPERATOR
  XCYCLOPS
  ULTRABOLTS
}

enum PlanLevel {
  GOLD
  SILVER
  BRONZE
  INACTIVE
}

// @TODO Check which positions are needed
enum RingPositions {
  RH_BACKS
  RH_SHOULDER
  RH_WALL_UPPER
  LH_BACKS
  LH_SHOULDER
  LH_WALL_UPPER
  CENTER_BACKS
}

model Company {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name       String
  orgNumber  Int    @unique // Has 10 exact digits in Sweden, does this apply for rest of world (maybe string?)
  address    String
  postalCode String
  city       String
  country    String

  companyContactEmail String

  User User[]
  Plan Plan[]
  Site Site[]

  @@map("companies")
}

model RefreshTokenId {
  userId    String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokenId String @unique

  @@map("refresh_token_ids")
}

// Plan access table pair between user and plan
// Split this out to separate concern between company access and user access inside company?
model Plan {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationName Application
  planLevel       PlanLevel
  expiringDate    DateTime?

  Company   Company @relation(fields: [companyId], references: [id])
  companyId String

  User   User?   @relation(fields: [userId], references: [id]) // TODO: Turn into array as multiple users can have the same plan
  userId String?

  @@map("plans")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String @unique
  hash  String

  role             Role // @TODO This needs to be set per company (COMPANY_ADMIN would be shared)
  fullname         String
  workPlace        String
  phoneNumber      String?
  globalVisibility Boolean? // Only relevant for role SANDVIK_TECHNICIAN

  Company    Company[]
  Plan       Plan[] // @TODO Check if possible to set relations to be unique
  BoltResult BoltResult[] // @TODO Check if this can be removed

  @@map("users")
}

model Site {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteName   String
  address    String
  postalCode String
  city       String
  country    String

  // passCriteria String
  // notification String

  Company   Company @relation(fields: [companyId], references: [id])
  companyId String

  Level      Level[]
  BoltResult BoltResult[] // @TODO Check if this can be removed

  @@map("sites")
}

model Level {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levelName String

  Site   Site   @relation(fields: [siteId], references: [id])
  siteId String

  Drive      Drive[]
  BoltResult BoltResult[] // @TODO Check if this can be removed

  @@map("levels")
}

model Drive {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driveName String

  Level   Level  @relation(fields: [levelId], references: [id])
  levelId String

  Position   Position[]
  BoltResult BoltResult[] // @TODO Check if this can be removed

  @@map("drives")
}

// @TODO Add ring position
model Position {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positionName Positions

  Drive   Drive  @relation(fields: [driveId], references: [id])
  driveId String

  BoltResult BoltResult[] // @TODO Check if this can be removed

  @@map("positions")
}

model BoltResult {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boltNumber       Int
  boltType         String // @TODO enum
  peakLoad         Int[]
  peakDisplacement Int[]
  positionInRing   String // @TODO remove

  result              Result
  isHazard            Boolean      @default(false)
  hazardCompletedDate DateTime[]
  abortReason         AbortReason?
  comment             String?
  image               String? // This assumes base64

  Site   Site   @relation(fields: [siteId], references: [id])
  siteId String

  Level   Level  @relation(fields: [levelId], references: [id])
  levelId String

  Drive   Drive  @relation(fields: [driveId], references: [id])
  driveId String

  // TODO: Add location!

  Position   Position @relation(fields: [positionId], references: [id]) // @TODO Rename ring position
  positionId String

  User   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("bolt_results")
}

////////////////////////////////////////

model Coffee {
  id        Int            @id @default(autoincrement())
  name      String
  brand     String
  flavors   CoffeeFlavor[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("coffees")
}

model Flavor {
  id        Int            @id @default(autoincrement())
  name      String
  coffees   CoffeeFlavor[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("flavors")
}

model CoffeeFlavor {
  coffeeId Int
  flavorId Int

  coffee Coffee @relation(fields: [coffeeId], references: [id])
  flavor Flavor @relation(fields: [flavorId], references: [id])

  @@id([coffeeId, flavorId])
  @@map("coffee_flavors")
}
