# Server-side only — used by NextAuth's CredentialsProvider to reach the NestJS
# REST auth endpoints (/auth/signin, /auth/refresh-tokens).
BACKEND_URL="http://localhost:3333"

# The main web portal (:3000). Used for post-sign-in and 404 redirects.
NEXT_PUBLIC_PORTAL_URL="http://localhost:3000"

NEXT_PUBLIC_HYDRA_URL="http://localhost:3003"

# NOTE: Hydra follows banshee's convention — this is the API origin with no
# /graphql suffix. UrqlProvider and codegen.ts both append `/graphql` themselves.
# (web and pull-test use the opposite convention and include /graphql here.)
NEXT_PUBLIC_API_URL="http://localhost:3333"

NEXTAUTH_URL="http://localhost:3003"
