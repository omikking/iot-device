{
  "extends": "@gsp/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    //"ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
    }
  },
// The d.ts file is included to fix build error of missing react-table types. Ugly fix, but it works for now... 
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../../packages/ui-banshee/src/types/react-table.d.ts"],
  "exclude": ["node_modules"]
}
