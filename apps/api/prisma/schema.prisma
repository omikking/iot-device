// This is the Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SANDVIK_ADMIN
  SANDVIK_TECHNICIAN
}

enum Role {
  COMPANY_USER
  COMPANY_ADMIN
  SANDVIK_ADMIN
  SANDVIK_TECHNICIAN
}

enum Result {
  PASS
  FAIL
  ABORT
}

enum PullTestAbortReason {
  NOT_TESTED_VOID_CAVITY
  TEST_STOPPED_INSTALL_ANGLE
}

enum Application {
  PULL_TEST
  PULL_TEST_OPERATOR
  XCYCLOPS
  ULTRABOLTS
}

enum PlanLevel {
  GOLD
  SILVER
  BRONZE
  INACTIVE
}

enum BoltType {
  MD47
  MDX47
}

enum RingPosition {
  LH_Backs
  Center_Backs
  RH_Backs
  LH_Face_High
  LH_Face_Low
  RH_Face_High
  RH_Face_Low
  LH_Shoulder
  LH_Wall_Upper
  LH_Wall_Center
  LH_Wall_Lower
  RH_Shoulder
  RH_Wall_Upper
  RH_Wall_Center
  RH_Wall_Lower
}

model RefreshTokenId {
  userId    String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokenId String @unique

  @@map("refresh_token_ids")
}

model Company {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                String
  orgNumber           String @unique
  address             String
  postalCode          String
  city                String
  country             String
  companyContactEmail String

  plan           Plan[]
  site           Site[]
  userPermission UserPermission[]

  @@map("companies")
}

model Plan {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationName Application
  planLevel       PlanLevel
  expiringDate    DateTime?

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  @@map("plans")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String @unique
  hash  String

  fullName           String
  workPlace          String
  phoneNumber        String?
  globalRole         GlobalRole? // For role SANDVIK_TECHNICIAN or SANDVIK_ADMIN
  isGlobalVisibility Boolean? // For role SANDVIK_TECHNICIAN

  userRole   UserPermission[]
  boltResult BoltResult[] // @TODO Check if this can be removed. - We just need to give every BoltResult a userId, is this the correct way?

  @@map("users")
}

model UserPermission {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role // SANDVIK_TECHNICIAN, SANDVIK_ADMIN, COMPANY_ADMIN or COMPANY_USER

  appsAccess Application[]

  user   User   @relation(fields: [userId], references: [id])
  userId String

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  @@map("user_permissions")
}

model Site {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteName   String
  address    String
  postalCode String
  city       String
  country    String

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  level      Level[]
  boltResult BoltResult[] // @TODO Check if this can be removed? - Harder to query then, we just want to give siteId to BoltResult, is this relation correct?

  @@map("sites")
}

model Level {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levelName String

  site   Site   @relation(fields: [siteId], references: [id])
  siteId String

  drive      Drive[]
  boltResult BoltResult[] // @TODO Check if this can be removed? - Harder to query then, we just want to give levelId to BoltResult, is this relation correct?

  @@map("levels")
}

model Drive {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driveName String

  level   Level  @relation(fields: [levelId], references: [id])
  levelId String

  location   Location[]
  boltResult BoltResult[] // @TODO Check if this can be removed? - Harder to query then, we just want to give driveId to BoltResult, is this relation correct?

  @@map("drives")
}

model Location {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationName String

  drive   Drive  @relation(fields: [driveId], references: [id])
  driveId String

  boltResult BoltResult[] // @TODO Check if this can be removed? - Harder to query then, we just want to give locationId to BoltResult, is this relation correct?

  @@map("locations")
}

model BoltResult {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boltNumber       Int
  boltType         BoltType
  peakLoad         Int[]
  peakDisplacement Int[]
  positionInRing   RingPosition

  result              Result
  isHazard            Boolean              @default(false)
  hazardCompletedDate DateTime[] // Need to make optional
  abortReason         PullTestAbortReason?
  comment             String?
  image               String? // base64

  site   Site   @relation(fields: [siteId], references: [id])
  siteId String

  level   Level  @relation(fields: [levelId], references: [id])
  levelId String

  drive   Drive  @relation(fields: [driveId], references: [id])
  driveId String

  location   Location @relation(fields: [locationId], references: [id])
  locationId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("bolt_results")
}

////////////////////////////////////////

model Coffee {
  id        Int            @id @default(autoincrement())
  name      String
  brand     String
  flavors   CoffeeFlavor[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("coffees")
}

model Flavor {
  id        Int            @id @default(autoincrement())
  name      String
  coffees   CoffeeFlavor[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("flavors")
}

model CoffeeFlavor {
  coffeeId Int
  flavorId Int

  coffee Coffee @relation(fields: [coffeeId], references: [id])
  flavor Flavor @relation(fields: [flavorId], references: [id])

  @@id([coffeeId, flavorId])
  @@map("coffee_flavors")
}
