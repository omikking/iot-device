    "@urql/exchange-auth": "^2.2.1",
    "@urql/next": "^1.1.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.546.0",
    "next": "16.0.5",
    "next-auth": "^4.24.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.65.0",
    "recharts": "3.5.1",
