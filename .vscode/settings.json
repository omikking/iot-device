{
  "prettier.enable": true,
  "editor.formatOnSave": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  // This adds IntelliSense for Tailwind classnames in cva.
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  // vscode-icons extension settings
  "vsicons.associations.folders": [
    {
        "icon": "www",
        "extensions": ["pull-test"],
        "format": "svg"
    },
    {
        "icon": "config",
        "extensions": ["eslint-config", "tailwind-config", "typescript-config"],
        "format": "svg"
    }
  ]
}
