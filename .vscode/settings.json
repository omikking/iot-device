{
  "prettier.enable": true,
  "editor.formatOnSave": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  // vscode-icons extension settings
  "vsicons.associations.folders": [
    {
        "icon": "www",
        "extensions": ["pull-test"],
        "format": "svg"
    }
  ]
}
