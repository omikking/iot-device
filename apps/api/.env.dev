# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://postgres:123@dev-db:5432/nest?schema=public"

JWT_SECRET="example"
JWT_ACCESS_TOKEN_TTL='900'
JWT_REFRESH_TOKEN_TTL='86400'

# SMTP4Dev configuration (when running locally)
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_SECURE=false
# smtp4dev doesn't support STARTTLS on its SMTP port
SMTP_REQUIRE_TLS=false
SMTP_USER=email@example.com
SMTP_PASSWORD=password
SMTP_FROM=noreply@localhost.com

# Application URL for invitation links
FRONTEND_URL=http://localhost:3000