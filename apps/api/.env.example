# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://postgres:123@localhost:5434/nest?schema=public"

JWT_SECRET="example"
JWT_ACCESS_TOKEN_TTL='900'
JWT_REFRESH_TOKEN_TTL='86400'

# SMTP4Dev configuration (when running locally)
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_SECURE=false
# smtp4dev doesn't support STARTTLS on its SMTP port, use true in production.
SMTP_REQUIRE_TLS=false
SMTP_USER=email@example.com
SMTP_PASSWORD=password
SMTP_FROM=noreply@localhost.com

# Application URL for invitation links
FRONTEND_URL=http://localhost:3000

#Proceq Creds
PROCEQ_CLIENT_ID=
PROCEQ_CLIENT_SECRET=
PROCEQ_SCOPE=openid email profile offline
PROCEQ_WORKSPACE_DOMAIN=stg-io.screeningeagle.com
PROCEQ_REGIONAL_DOMAIN=sg-stg-io.screeningeagle.com
PROCEQ_REDIRECT_URI=http://localhost:3333/callback

# Proceq sync scheduler (multi-technician windowed sync).
# Kill-switch for the automatic cronjob. Shipped DISABLED by default so
# headless sync is an explicit opt-in per environment — set to "false" to run.
PROCEQ_SYNC_DISABLED=true
# Max technicians synced concurrently within a cycle (integer >= 1; default 5).
PROCEQ_SYNC_WINDOW_SIZE=5
# Cron cadence in minutes (integer 1-60; default 10). Applied at startup.
PROCEQ_SYNC_INTERVAL_MINUTES=10