{
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "plugins": [
        "@ianvs/prettier-plugin-sort-imports"
    ],
    "importOrder": [
        "^node:",
        "",
        "^react$",
        "<THIRD_PARTY_MODULES>",
        "",
        "^@gsp/(.*)$",
        "",
        "^@/(?!styles|types|components)(.*)$",
        "",
        "^@/components/(.*)$",
        "",
        "^..?/(.*)$",
        "",
        "@/styles/(.*)$",
        "",
        "@/types/(.*)$"
    ]
}