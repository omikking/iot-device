{
  "name": "@gsp/ui",
  "author": "Felix Östergren <felix.ostergren@sandvik.com>",
  "private": true,
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./styles.css": "./dist/index.css",
    ".": "./dist/index.js",
    "./": "./dist/"
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "lint": "eslint src/",
    "dev": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "newbuild": "tsup && tsc-alias -p tsconfig.json",
    "newbuild2": "tsup",
    "newbuild3": "tsup ./src --dts --clean --external react react-dom",
    "newdev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@gsp/eslint-config": "workspace:*",
    "@gsp/tailwind-config": "workspace:*",
    "@gsp/typescript-config": "workspace:*",
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.61",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "tsc-alias": "^1.8.10",
    "tsup": "^8.1.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.6.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.379.0",
    "react-hook-form": "^7.51.5",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  }
}