    "@svgr/webpack": "^8.1.0",
    "@urql/exchange-auth": "^2.2.1",
    "@urql/next": "^1.1.3",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.379.0",
    "next": "^14.1.1",
    "next-auth": "^4.24.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.5",
    "urql": "^4.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.12.16",
    "@graphql-codegen/cli": "^5.0.3",
