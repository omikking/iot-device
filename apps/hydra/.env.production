BACKEND_URL=http://api:3333
COOKIE_DOMAIN=.groundsupport.mining.sandvik
NEXT_PUBLIC_PORTAL_URL=https://portal.groundsupport.mining.sandvik
NEXT_PUBLIC_HYDRA_URL=https://hydra.groundsupport.mining.sandvik
# Hydra follows banshee's convention: API origin with NO /graphql suffix —
# UrqlProvider and codegen.ts both append it themselves.
NEXT_PUBLIC_API_URL=https://groundsupport.mining.sandvik
NEXTAUTH_URL=https://hydra.groundsupport.mining.sandvik
#  It must match the secret used by web / pull-test / banshee for cross-app sign-in to work. Do not commit real secrets to git. Use a placeholder and generate a new one for each deployment.
NEXTAUTH_SECRET="<generate with: openssl rand -base64 32>"
