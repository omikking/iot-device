    "@gsp/eslint-config": "workspace:*",
    "@gsp/tailwind-config": "workspace:*",
    "@gsp/typescript-config": "workspace:*",
    "@next/eslint-plugin-next": "^14.1.1",
    "@parcel/watcher": "^2.5.0",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.2",
    "graphql": "^16.10.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
